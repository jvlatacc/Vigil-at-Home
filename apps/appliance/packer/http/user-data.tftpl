#cloud-config
# Build-boot seed for the Packer QEMU build only. Rendered at packer time
# (appliance.pkr.hcl, cd_content) with the fresh per-build SSH public key
# that apps/appliance/scripts/build.sh generates. The builder account's
# credentials are removed by provision/harden.sh and the account itself is
# deleted at the appliance's first boot — none of this survives in a
# deployed appliance.
hostname: vigil-appliance-build

users:
  - name: builder
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ${builder_ssh_pubkey}

ssh_pwauth: false
