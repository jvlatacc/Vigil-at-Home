#cloud-config
# Build-boot seed for the Packer QEMU build only. Rendered at packer time
# (appliance.pkr.hcl, cd_content) with the fresh per-build SSH public key
# that apps/appliance/scripts/build.sh generates. The builder account, its
# key, and its sudoers rule are removed by the appliance's first boot
# (provision/harden.sh installs the removal) — none of this survives in a
# deployed appliance, and the key's private half never enters the image.
hostname: vigil-appliance-build

users:
  - name: builder
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ${builder_ssh_pubkey}

ssh_pwauth: false
