[Unit]
Description=Vigil kernel monitor (eBPF operations index + alerts)
Documentation=https://github.com/jvlatacc/Vigil-at-Home/tree/main/kernel-monitor
# rsyslog must be up so VIGOP messages reach /dev/log immediately; the daemon
# reconnects on its own if rsyslog starts later.
After=rsyslog.service

[Service]
Type=simple
ExecStart=/usr/libexec/vigil-kernel-monitor/vigil-kernel-monitor --index-dir /var/lib/vigil/kernel-monitor --rules-dir /etc/vigil/kernel-monitor/rules
# CAP_BPF + CAP_PERFMON cover tracepoint loads on 5.8+; BPF LSM attach would
# need CAP_BPF only. No CAP_SYS_ADMIN.
AmbientCapabilities=CAP_BPF CAP_PERFMON
CapabilityBoundingSet=CAP_BPF CAP_PERFMON
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/vigil/kernel-monitor
RestrictAddressFamilies=AF_UNIX
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
